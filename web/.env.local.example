# Copy to .env.local for local development.

# The REST API (internal/api). When running the API via docker-compose or
# `go run ./cmd/api`, this is http://localhost:8080. When the API is behind
# the EKS ALB, use that public URL instead.
NEXT_PUBLIC_API_URL=http://localhost:8080

# The gRPC telemetry service (internal/grpcserver). This is read server-side
# only, by app/api/telemetry/[satelliteId]/route.ts -- browsers can't speak
# gRPC directly, so the dashboard's own backend proxies the call. Locally
# this is grpc-server's docker-compose port; in EKS it's the ClusterIP
# service's DNS name (grpc-server.satellite-tracker.svc.cluster.local:9090),
# reachable only from inside the cluster -- which is exactly why this route
# handler exists instead of calling gRPC from the browser.
GRPC_SERVER_ADDR=localhost:9090

# From `terraform -chdir=terraform output cognito_user_pool_id` /
# cognito_app_client_id / cognito_issuer_url, and the pool's domain (the
# part of cognito_hosted_ui_url before ".auth.<region>.amazoncognito.com").
NEXT_PUBLIC_COGNITO_DOMAIN=satellite-tracker-auth-xxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-west-2
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/callback
